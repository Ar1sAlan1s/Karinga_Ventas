# Configuración del servidor Backend Karinga
PORT=4000
NODE_ENV=development

# Conexión a Base de Datos PostgreSQL (Neon)
DATABASE_URL=postgresql://usuario:contraseña@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require

# Ejecutar automáticamente migraciones y seed al iniciar el servidor (true/false)
AUTO_MIGRATE=true

# =======================================================
# Seguridad y Autenticación JWT
# (Nunca escribas contraseñas reales en este archivo de ejemplo)
# =======================================================
JWT_SECRET=escribe_aqui_una_clave_secreta_larga_y_aleatoria
INITIAL_ADMIN_EMAIL=admin_ejemplo@dominio.com
INITIAL_ADMIN_PASSWORD=escribe_aqui_una_contrasena_fuerte

# URL del Frontend (CORS)
FRONTEND_URL=http://localhost:5173

# =======================================================
# Google Calendar API (OAuth 2.0 para cuenta suscrita)
# =======================================================
# Credenciales de Google Cloud Console (Flujo OAuth 2.0)
GOOGLE_CLIENT_ID=tu_cliente_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_cliente_secret
GOOGLE_REFRESH_TOKEN=tu_refresh_token_obtenido

# =======================================================
# Mapeo de Identificadores de Calendario por Cabaña
# (ID de Google Calendar para cada cabaña individual)
# =======================================================
CALENDAR_BUENAVISTA_ID=c_buenavista@group.calendar.google.com
CALENDAR_CHUPICUARO_ID=c_chupicuaro@group.calendar.google.com
CALENDAR_IREKANI_ID=c_irekani@group.calendar.google.com
CALENDAR_ERANDINI_ID=c_erandini@group.calendar.google.com
CALENDAR_JARACUARO_ID=c_jaracuaro@group.calendar.google.com
CALENDAR_TECUENITA_ID=c_tecuenita@group.calendar.google.com
CALENDAR_TECUEN_ID=c_tecuen@group.calendar.google.com
CALENDAR_PACANDA_ID=c_pacanda@group.calendar.google.com
CALENDAR_YUNUEN_ID=c_yunuen@group.calendar.google.com
CALENDAR_SANTAFE_ID=c_santafe@group.calendar.google.com
CALENDAR_JANITZIO_ID=c_janitzio@group.calendar.google.com
CALENDAR_URANDEN_ID=c_uranden@group.calendar.google.com
CALENDAR_SANTACLARA_ID=c_santaclara@group.calendar.google.com
